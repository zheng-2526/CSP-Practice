    border-radius: 0px;
    color: #202020;
    font-size: 28px;
    font-weight: 400;
    padding: 6px 10px;
}
QPushButton {
    background: #f7f7f7;
    border: 1px solid #a6a6a6;
    border-radius: 2px;
    color: #202020;
    font-size: 18px;
    font-weight: 400;
}
QPushButton[buttonType="number"] {
    color: #2438b8;
}
QPushButton[buttonType="operator"] {
    color: #d13232;
}
QPushButton[buttonType="extra"] {
    color: #2438b8;
}
QPushButton[buttonType="equal"] {
    color: #2438b8;
}
QPushButton:hover {
    background: #e9f3ff;
    border-color: #4b83c3;
}
QPushButton:pressed {
    background: #d8e9fb;
}</string>
